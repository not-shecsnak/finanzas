# Variables locales. Copia este archivo a .env (no se versiona) y completa los valores.
# Linear — SOLO el usuario edita .env. Claude nunca lo lee ni lo escribe.
# API key: Linear -> Settings -> Security & access -> Personal API keys
LINEAR_API_KEY=pega_aqui_tu_api_key_de_linear
# Prefijo de tus issues (Linear → Settings → Teams → Identifier)
LINEAR_TEAM_KEY=TY

# Supabase (Project Settings -> API). Solo el origen del proyecto, sin /rest/v1/.
NEXT_PUBLIC_SUPABASE_URL=https://<id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pega_aqui_la_anon_key_publica
